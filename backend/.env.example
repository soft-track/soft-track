# Copy this file to .env and adjust as needed.

# SQLite by default. For Postgres: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./softtrack.db

# "development" keeps the convenient defaults below. Set anything else
# (production, staging, ...) and the app refuses to start while SECRET_KEY is
# still the published default.
ENVIRONMENT=development

# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-key-change-me-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list is not supported directly by pydantic-settings list parsing
# from env vars in this app; edit the cors_origins default in web.py instead
# if you need to change allowed frontend origins.

# --- Attachments -----------------------------------------------------------
# Where uploaded files are kept. "local" writes them under ATTACHMENT_DIR;
# "s3" puts them in any S3-compatible bucket (AWS, MinIO, Ceph, R2, Spaces)
# and needs `pip install boto3`.
ATTACHMENT_STORAGE=local
ATTACHMENT_DIR=./attachments

# Refused before the file is read, so an oversized upload costs nothing.
ATTACHMENT_MAX_BYTES=26214400

# Only read when ATTACHMENT_STORAGE=s3. Credentials are deliberately not
# settings here -- boto3's usual chain (AWS_ACCESS_KEY_ID / AWS_PROFILE / an
# instance role) already handles them, and a second copy would be one more
# place for a secret to leak.
# ATTACHMENT_S3_BUCKET=softtrack-files
# ATTACHMENT_S3_ENDPOINT_URL=https://minio.example:9000   # blank for AWS
# ATTACHMENT_S3_REGION=eu-west-1
# ATTACHMENT_S3_PREFIX=attachments
