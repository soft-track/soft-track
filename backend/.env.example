# Copy this file to .env and adjust as needed.

# SQLite by default. For Postgres: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./softtrack.db

# "development" keeps the convenient defaults below. Set anything else
# (production, staging, ...) and the app refuses to start while SECRET_KEY is
# still the published default.
ENVIRONMENT=development

# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-key-change-me-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Accounts --------------------------------------------------------------
# true  -- anyone who can reach /register can create an account.
# false -- an account can only be created from an invitation link sent by a
#          team admin. The switch an internal instance wants on day one.
# Either way, the first account ever registered becomes the site administrator.
OPEN_REGISTRATION=true

# How long an invitation link stays usable.
INVITE_EXPIRE_DAYS=7

# --- The signed-out front door ---------------------------------------------
# true  -- / shows a landing page saying what SoftTrack is, with a way in.
# false -- / goes straight to /login, which is what SoftTrack did before there
#          was a landing page. The switch to set on a company instance behind
#          a VPN, where everyone opening it already knows what it is and the
#          page is one extra click every morning for all of them.
LANDING_PAGE=true

# There is no setting for the demo credentials hint. The sign-in page prefills
# demo@softtrack.dev and prints its password only where ENVIRONMENT is
# "development" or "demo" -- the two that seed.py actually seeds with that
# account. Set ENVIRONMENT to anything else and both disappear, which is the
# point: it is a working password, and it belongs on the public demo only.

# Comma-separated list is not supported directly by pydantic-settings list parsing
# from env vars in this app; edit the cors_origins default in web.py instead
# if you need to change allowed frontend origins.

# --- Attachments -----------------------------------------------------------
# Where uploaded files are kept. "local" writes them under ATTACHMENT_DIR;
# "s3" puts them in any S3-compatible bucket (AWS, MinIO, Ceph, R2, Spaces)
# and needs `pip install boto3`.
ATTACHMENT_STORAGE=local
ATTACHMENT_DIR=./attachments

# Refused before the file is read, so an oversized upload costs nothing.
ATTACHMENT_MAX_BYTES=26214400

# Only read when ATTACHMENT_STORAGE=s3. Credentials are deliberately not
# settings here -- boto3's usual chain (AWS_ACCESS_KEY_ID / AWS_PROFILE / an
# instance role) already handles them, and a second copy would be one more
# place for a secret to leak.
# ATTACHMENT_S3_BUCKET=softtrack-files
# ATTACHMENT_S3_ENDPOINT_URL=https://minio.example:9000   # blank for AWS
# ATTACHMENT_S3_REGION=eu-west-1
# ATTACHMENT_S3_PREFIX=attachments

# --- Repository integration -------------------------------------------------
# Where *this API* is reachable from GitHub or GitLab, used to build the
# webhook URLs shown on a team's Repositories page. Distinct from
# APP_BASE_URL below, which is the browser app -- the provider posts to the
# API directly and never loads the frontend.
#
# Worth setting on any instance that is not your laptop: a webhook URL
# pointing at localhost is one that silently never fires, and the failure
# reads as "the integration does not work" rather than "the URL was wrong".
API_BASE_URL=http://localhost:8000

# --- Notifications ---------------------------------------------------------
# The in-app inbox always works. Email is optional and off until SMTP_HOST is
# set: with no host configured no digest loop runs, and the per-user switch is
# hidden rather than promising a mail nothing will send.
#
# Where this instance is reachable, used for the issue links inside a digest --
# and for the Open Graph tags in the frontend's index.html, so a link pasted
# into Slack unfurls with a preview image that resolves. The frontend takes it
# as a build argument (docker compose passes this same value through), because
# there is no server rendering index.html per request.
APP_BASE_URL=http://localhost:5173

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=softtrack
# SMTP_PASSWORD=
# STARTTLS on the port above. Set false only for a local relay.
# SMTP_USE_TLS=true
# EMAIL_FROM=softtrack@example.com

# How often the digest loop wakes up, and how long a notification waits before
# it can be mailed. The delay is what makes this a digest rather than a mail
# per event: someone triaging a dozen issues generates one email, not twelve,
# and anything read in the app before the delay is up is never mailed at all.
# DIGEST_INTERVAL_MINUTES=15
# DIGEST_DELAY_MINUTES=10
